@model UniMove.Models.ViewModels.InstituicaoViewModel

@{
    ViewData["Title"] = "Excluir instituição";
}

<h1 class="h3 mb-3">Excluir instituição</h1>

<div class="alert alert-warning">
    Tem certeza de que deseja excluir <strong>@Model.Nome</strong> (@Model.Cidade)?
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>