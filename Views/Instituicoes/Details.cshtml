@model UniMove.Models.ViewModels.InstituicaoViewModel

@{
    ViewData["Title"] = "Detalhes da instituição";
}

<h1 class="h3 mb-3">Detalhes da instituição</h1>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>
    <dt class="col-sm-2">Cidade</dt>
    <dd class="col-sm-10">@Model.Cidade</dd>
</dl>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
<a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>