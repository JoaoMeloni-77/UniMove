@model UniMove.Models.ViewModels.ViagemViewModel

<div class="mb-3">
    <label asp-for="RotaId" class="form-label"></label>
    <select asp-for="RotaId" asp-items="Model.Rotas" class="form-select">
        <option value="0">Selecione...</option>
    </select>
    <span asp-validation-for="RotaId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="MotoristaId" class="form-label"></label>
    <select asp-for="MotoristaId" asp-items="Model.Motoristas" class="form-select">
        <option value="0">Selecione...</option>
    </select>
    <span asp-validation-for="MotoristaId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="VeiculoId" class="form-label"></label>
    <select asp-for="VeiculoId" asp-items="Model.Veiculos" class="form-select">
        <option value="0">Selecione...</option>
    </select>
    <span asp-validation-for="VeiculoId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="DataHoraPartida" class="form-label"></label>
    <input asp-for="DataHoraPartida" class="form-control" />
    <span asp-validation-for="DataHoraPartida" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Tipo" class="form-label"></label>
    <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<UniMove.Models.Enums.TipoViagem>()" class="form-select"></select>
    <span asp-validation-for="Tipo" class="text-danger"></span>
</div>