@model IEnumerable<UniMove.Models.ViewModels.ViagemViewModel>

@{
    ViewData["Title"] = "Viagens";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Viagens</h1>
    <a class="btn btn-primary" asp-action="Create">Nova viagem</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhuma viagem cadastrada.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Partida</th>
                    <th>Tipo</th>
                    <th>Rota</th>
                    <th>Motorista</th>
                    <th>Veículo</th>
                    <th>Reservas</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.DataHoraPartida.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Tipo</td>
                        <td>@item.RotaNome</td>
                        <td>@item.MotoristaNome</td>
                        <td>@item.VeiculoDescricao</td>
                        <td>@item.ReservasAtivas / @item.Capacidade</td>
                        <td><span class="badge @item.ClasseStatus">@item.Status</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                            @if (item.EstaAgendada)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                                <form asp-action="Cancelar" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Cancelar esta viagem?');">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Cancelar</button>
                                </form>
                            }
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}