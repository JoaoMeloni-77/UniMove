@model UniMove.Models.ViewModels.ViagemViewModel

@{
    ViewData["Title"] = "Editar viagem";
}

<h1 class="h3 mb-3">Editar viagem</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />

            <partial name="_Campos" model="Model" />

            <button type="submit" class="btn btn-primary">Salvar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}