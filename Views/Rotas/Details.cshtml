@model UniMove.Models.ViewModels.RotaViewModel

@{
    ViewData["Title"] = "Detalhes da rota";
}

<h1 class="h3 mb-3">Detalhes da rota</h1>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nome)</dt>
    <dd class="col-sm-9">@Model.Nome</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DuracaoMinutos)</dt>
    <dd class="col-sm-9">@Model.DuracaoMinutos</dd>
</dl>

<h2 class="h5 mt-4">Pontos de embarque</h2>

@if (!Model.Pontos.Any())
{
    <div class="alert alert-info">Esta rota ainda não tem pontos de embarque.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Ordem</th>
                    <th>Nome</th>
                    <th>Referência</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ponto in Model.Pontos)
                {
                    <tr>
                        <td>@ponto.Ordem</td>
                        <td>@ponto.Nome</td>
                        <td>@ponto.Referencia</td>
                        <td class="text-end">
                            <form asp-action="RemoverPonto" asp-route-rotaId="@Model.Id" asp-route-pontoId="@ponto.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h5 mt-4">Adicionar ponto</h2>

<form asp-action="AdicionarPonto" asp-route-rotaId="@Model.Id" method="post" class="row g-2 mb-4">
    <div class="col-md-4">
        <input name="Nome" class="form-control" placeholder="Nome do ponto" maxlength="100" required />
    </div>
    <div class="col-md-5">
        <input name="Referencia" class="form-control" placeholder="Referência (opcional)" maxlength="150" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Adicionar</button>
    </div>
</form>

<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar rota</a>
<a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>