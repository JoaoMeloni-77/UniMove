@model UniMove.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Painel";
}

<h1 class="h3 mb-4">Painel administrativo</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card text-center"><div class="card-body">
            <div class="text-muted">Viagens</div>
            <div class="display-6">@Model.Indicadores.TotalViagens</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-center"><div class="card-body">
            <div class="text-muted">Alunos cadastrados</div>
            <div class="display-6">@Model.Indicadores.TotalAlunos</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-center"><div class="card-body">
            <div class="text-muted">Passageiros previstos</div>
            <div class="display-6">@Model.Indicadores.PassageirosPrevistos</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-center"><div class="card-body">
            <div class="text-muted">Ocupação prevista</div>
            <div class="display-6">@Model.Indicadores.OcupacaoPrevista.ToString("0.#")%</div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h2 class="h5">Ocupação por viagem (próximas viagens)</h2>
        @if (!Model.Ocupacao.Any())
        {
            <div class="alert alert-info mb-0">Não há viagens agendadas.</div>
        }
        else
        {
            <canvas id="grafico" height="110"></canvas>
        }
    </div>
</div>

@section Scripts {
    @if (Model.Ocupacao.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
        <script>
            const rotulos = @Json.Serialize(Model.Ocupacao.Select(o => o.Rotulo));
            const reservas = @Json.Serialize(Model.Ocupacao.Select(o => o.Reservas));
            const capacidade = @Json.Serialize(Model.Ocupacao.Select(o => o.Capacidade));

            new Chart(document.getElementById('grafico'), {
                type: 'bar',
                data: {
                    labels: rotulos,
                    datasets: [
                        { label: 'Reservas', data: reservas },
                        { label: 'Capacidade', data: capacidade }
                    ]
                },
                options: { scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
            });
        </script>
    }
}